<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.snsapp.backend.mapper.CommentMapper">

    <resultMap id="commentResponseResultMap" type="com.snsapp.backend.dto.CommentResponse">
        <id property="id" column="id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="authorId" column="author_id"/>
        <result property="authorUsername" column="author_username"/>
        <result property="authorDisplayName" column="author_display_name"/>
    </resultMap>

    <resultMap id="commentResultMap" type="com.snsapp.backend.domain.Comment">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByPostId" resultMap="commentResponseResultMap">
        SELECT
            c.id, c.content, c.created_at,
            u.id AS author_id, u.username AS author_username, u.display_name AS author_display_name
        FROM comments c
        JOIN users u ON c.user_id = u.id
        WHERE c.post_id = #{postId}
        ORDER BY c.created_at ASC, c.id ASC
    </select>

    <select id="findResponseById" resultMap="commentResponseResultMap">
        SELECT
            c.id, c.content, c.created_at,
            u.id AS author_id, u.username AS author_username, u.display_name AS author_display_name
        FROM comments c
        JOIN users u ON c.user_id = u.id
        WHERE c.id = #{id}
    </select>

    <select id="findById" resultMap="commentResultMap">
        SELECT id, post_id, user_id, content, created_at
        FROM comments
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.snsapp.backend.domain.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (post_id, user_id, content, created_at)
        VALUES (#{postId}, #{userId}, #{content}, now())
    </insert>

    <delete id="deleteById">
        DELETE FROM comments
        WHERE id = #{id}
    </delete>

</mapper>
