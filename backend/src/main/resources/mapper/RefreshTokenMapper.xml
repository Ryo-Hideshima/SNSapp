<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.snsapp.backend.mapper.RefreshTokenMapper">

    <resultMap id="refreshTokenResultMap" type="com.snsapp.backend.domain.RefreshToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="revokedAt" column="revoked_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.snsapp.backend.domain.RefreshToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at, created_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt}, now())
    </insert>

    <update id="revokeByTokenHash">
        UPDATE refresh_tokens
        SET revoked_at = #{revokedAt}
        WHERE token_hash = #{tokenHash}
    </update>

    <!--
        「まだ使えるトークンか確認してから失効させる」を1回のUPDATEで原子的に行う。
        SELECTしてからUPDATEする2ステップにすると、同じリフレッシュトークンでの同時リクエストが
        両方とも検証を通過してしまう競合状態が発生するため、WHERE句に有効性の条件を含めた
        UPDATE ... RETURNING で一度に判定と失効を行う(条件に合致し実際に更新できた行だけが返る)。
    -->
    <select id="revokeIfUsable" resultMap="refreshTokenResultMap">
        UPDATE refresh_tokens
        SET revoked_at = #{revokedAt}
        WHERE token_hash = #{tokenHash}
          AND revoked_at IS NULL
          AND expires_at > #{now}
        RETURNING id, user_id, token_hash, expires_at, revoked_at, created_at
    </select>

</mapper>
